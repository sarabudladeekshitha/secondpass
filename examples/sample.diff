diff --git a/test/refunds.test.ts b/test/refunds.test.ts
new file mode 100644
index 0000000..8159198
--- /dev/null
+++ b/test/refunds.test.ts
@@ -0,0 +1,12 @@
+import { describe, it, expect } from "vitest";
+import { refundPayment } from "../src/payments/refunds";
+
+describe("refundPayment", () => {
+  it("refunds the remaining balance by default", async () => {
+    await expect(refundPayment("pay_1", "user_1")).resolves.toBeUndefined();
+  });
+
+  it("rejects refunds larger than the remaining balance", async () => {
+    await expect(refundPayment("pay_1", "user_1", "999.00")).rejects.toThrow("exceeds");
+  });
+});
