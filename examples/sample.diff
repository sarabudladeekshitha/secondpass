diff --git a/src/payments/refunds.ts b/src/payments/refunds.ts
index bb47111..9156498 100644
--- a/src/payments/refunds.ts
+++ b/src/payments/refunds.ts
@@ -3,16 +3,24 @@ import type { Payment } from "./types";
 
 export const MAX_REFUND_WINDOW_DAYS = 30;
 
-export async function refundPayment(paymentId: string, actorId: string) {
+export async function refundPayment(paymentId: string, actorId: string, requestedAmount?: string) {
   const payment: Payment = await db.payments.find(paymentId);
   if (!payment) throw new Error("payment not found");
-  if (payment.status !== "captured") {
+  if (payment.status !== "captured" && payment.status !== "partially_refunded") {
     throw new Error("only captured payments can be refunded");
   }
   const ageDays = (Date.now() - payment.capturedAt.getTime()) / 86_400_000;
-  if (ageDays > MAX_REFUND_WINDOW_DAYS) {
+  if (ageDays >= MAX_REFUND_WINDOW_DAYS) {
     throw new Error("refund window has closed");
   }
-  await db.refunds.insert({ paymentId, amountCents: payment.amountCents, actorId });
-  await db.payments.update(paymentId, { status: "refunded" });
+  const alreadyRefunded = await db.refunds.sumForPayment(paymentId);
+  const refundAmountCents = requestedAmount
+    ? Math.round(parseFloat(requestedAmount) * 100)
+    : payment.amountCents - alreadyRefunded;
+  if (refundAmountCents > payment.amountCents - alreadyRefunded) {
+    throw new Error("refund exceeds remaining balance");
+  }
+  await db.refunds.insert({ paymentId, amountCents: refundAmountCents, actorId });
+  const fullyRefunded = alreadyRefunded + refundAmountCents === payment.amountCents;
+  await db.payments.update(paymentId, { status: fullyRefunded ? "refunded" : "partially_refunded" });
 }
